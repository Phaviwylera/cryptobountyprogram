# Copy to deploy/.env (docker) or /opt/bountyscan/deploy/bountyscan.env (systemd) and fill in.
# NEVER commit the filled-in file.

# Free key from https://etherscan.io/myapikey (Etherscan V2 covers many chains with one key)
ETHERSCAN_API_KEY=your_etherscan_key_here

# JSON-RPC endpoint for live discovery + balance checks.
# Free, no signup: https://ethereum-rpc.publicnode.com
# Or your own Alchemy/Infura URL for higher rate limits.
RPC_URL=https://ethereum-rpc.publicnode.com

# Resume scanning automatically after restarts/reboots: live (follow the chain) | drain (finish the queue) | empty (manual)
BOUNTYSCAN_AUTOSTART=live
# Optional: skip contracts holding less than this much native coin (0 = scan everything)
BOUNTYSCAN_MIN_BALANCE=0
